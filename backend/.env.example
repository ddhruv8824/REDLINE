# Copy to backend/.env — everything here is optional.

# Server-side fallback keys. Users can instead paste their own key in the UI
# (AI settings), which is sent per request and never stored on the server.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# Where workspaces (resumes, profiles, versions) are stored. Default: backend/data
# REDLINE_DATA_DIR=

# Extra origins allowed to call the API (comma-separated), e.g. a deployed frontend.
# Any http://localhost:<port> / http://127.0.0.1:<port> is always allowed.
# CORS_ORIGINS=https://tailor.example.com
